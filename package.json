{
  "name": "toyota-taller-peru",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tz": "cross-env TZ=UTC vitest run tests/fechas.test.ts && cross-env TZ=Asia/Tokyo vitest run tests/fechas.test.ts && cross-env TZ=America/New_York vitest run tests/fechas.test.ts",
    "eval": "tsx evals/runner.ts",
    "check:server-only": "node scripts/check-server-only.mjs",
    "generar-placeholders": "node scripts/generar-placeholders.mjs",
    "descargar-imagenes": "node scripts/descargar-imagenes-reales.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "googleapis": "^144.0.0",
    "next": "15.5.23",
    "openai": "^4.68.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "tailwindcss": "^4",
    "tsx": "^4.19.1",
    "typescript": "^5",
    "vitest": "^2.1.4"
  }
}
